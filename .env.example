# Copy to repo-root .env (gitignored; backend/.env, if present, overrides it) and fill in. Names only; never commit values.
# Dev defaults are shown as comments.

# --- Secrets (host secret store / backend environment only) ---
GEMINI_API_KEY=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=
DATABASE_URL=
MIGRATION_DATABASE_URL=
AHOY_OWNER_PASSWORD=
AHOY_APP_PASSWORD=

# --- Non-secret settings ---
# dev default: http://127.0.0.1:5173
APP_ORIGIN=
# dev | test | prod. Unset means prod (fail-safe: https origin required, mocks refused).
# Keep this as dev for local development; production must not set dev or test.
AHOY_ENV=dev
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GEMINI_MODEL=
ALLOWED_MODELS=
TRUSTED_PROXY_IPS=
REPO_CACHE_DIR=
REPO_CACHE_MAX_GB=
GIT_HISTORY_DEPTH=
MAX_CONCURRENT_STEPS=
USER_MAX_RUNNING_STEPS=
USER_MAX_DAILY_STEPS=
USER_MAX_SESSIONS=
AHOY_SANDBOX_RUNTIME=
RUNNER_SOCKET=
